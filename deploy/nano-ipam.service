[Unit]
Description=Nano IPAM - Lightweight IP Address Management Service
Documentation=https://github.com/besselman/nano-ipam
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nano-ipam
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=5s

# Environment settings
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=DATA_PATH=/var/lib/nano-ipam/ipam.db

# Standard HTTPS Port 443 with auto-redirect from HTTP Port 80
Environment=PORT=443
Environment=SSL_CERT_PATH=/var/lib/nano-ipam/certs/cert.pem
Environment=SSL_KEY_PATH=/var/lib/nano-ipam/certs/key.pem
Environment=HTTP_REDIRECT_PORT=80

# Resource limits & security for LXC container
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nano-ipam

[Install]
WantedBy=multi-user.target
